{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OPIS independent AI review V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "prompt_version",
    "standard_version",
    "queue_id",
    "event_id",
    "model",
    "source",
    "independence",
    "facts",
    "attributes",
    "limitations",
    "status",
    "approved",
    "can_ship"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "prompt_version": {
      "const": "1.0"
    },
    "standard_version": {
      "const": "1.0"
    },
    "queue_id": {
      "type": "string",
      "pattern": "^ROOT-[0-9]{3}$"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "version",
        "run_date"
      ],
      "properties": {
        "provider": {
          "enum": [
            "GEMINI",
            "CLAUDE"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_date": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "report_number",
        "report_date",
        "sha256",
        "pdf_page_count",
        "reading_scope",
        "verification"
      ],
      "properties": {
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "report_number": {
          "type": [
            "string",
            "null"
          ]
        },
        "report_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          ]
        },
        "pdf_page_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "reading_scope": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "enum": [
            "BINARY_HASH_VERIFIED",
            "PDF_READ_HASH_UNAVAILABLE"
          ]
        }
      }
    },
    "independence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "other_ai_outputs_seen",
        "notes"
      ],
      "properties": {
        "other_ai_outputs_seen": {
          "const": false
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "summary",
          "kind",
          "source_refs",
          "limitation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(GEMINI|CLAUDE)-F[0-9]{2,}$"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "OBSERVED_FACT",
              "INVESTIGATOR_FINDING",
              "OPERATOR_STATEMENT",
              "REPORTED_ASSESSMENT"
            ]
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/source_ref"
            }
          },
          "limitation": {
            "type": "string"
          }
        }
      }
    },
    "attributes": {
      "type": "array",
      "minItems": 40,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "review_key",
          "code",
          "name",
          "role",
          "review_result",
          "rationale",
          "fact_ids",
          "source_refs",
          "counterevidence_or_limitation"
        ],
        "properties": {
          "review_key": {
            "type": "string",
            "pattern": "^ROOT-[0-9]{3}-[A-Z]{2}[1-8]$"
          },
          "code": {
            "enum": [
              "PA1",
              "PA2",
              "PA3",
              "QA1",
              "QA2",
              "QA3",
              "QA4",
              "CO1",
              "CO2",
              "CO3",
              "CO4",
              "LA1",
              "LA2",
              "LA3",
              "LA4",
              "LA5",
              "LA6",
              "LA7",
              "LA8",
              "DM1",
              "DM2",
              "DM3",
              "WE1",
              "WE2",
              "WE3",
              "WE4",
              "CL1",
              "CL2",
              "CL3",
              "CL4",
              "PI1",
              "PI2",
              "PI3",
              "PI4",
              "RC1",
              "RC2",
              "WP1",
              "WP2",
              "WP3",
              "WP4"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "D",
              "I",
              "A",
              "H",
              "P",
              "N"
            ]
          },
          "review_result": {
            "enum": [
              "선정",
              "미선정",
              "판단보류"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "fact_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "source_refs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/source_ref"
            }
          },
          "counterevidence_or_limitation": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "role": {
                  "enum": [
                    "D",
                    "I"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "review_result": {
                  "const": "선정"
                },
                "fact_ids": {
                  "minItems": 1
                },
                "source_refs": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "role": {
                  "const": "A"
                }
              }
            },
            "then": {
              "properties": {
                "review_result": {
                  "const": "판단보류"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "role": {
                  "enum": [
                    "H",
                    "P",
                    "N"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "review_result": {
                  "const": "미선정"
                }
              }
            }
          }
        ]
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "const": "INDEPENDENT_DRAFT"
    },
    "approved": {
      "const": false
    },
    "can_ship": {
      "const": false
    }
  },
  "$defs": {
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section",
        "printed_pages",
        "pdf_pages",
        "summary"
      ],
      "properties": {
        "section": {
          "type": [
            "string",
            "null"
          ]
        },
        "printed_pages": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "pdf_pages": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      },
      "anyOf": [
        {
          "properties": {
            "printed_pages": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "pdf_pages": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "section": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  }
}
