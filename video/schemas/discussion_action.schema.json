{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Discussion and action manifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "artifact_type": {
      "const": "DISCUSSION_ACTION"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "PLANNED",
        "SCRIPT_DRAFT",
        "CONTENT_REVIEWED",
        "ASSET_READY",
        "EDITED",
        "FINAL_QC",
        "APPROVED",
        "STALE"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "document_path": {
          "type": "string",
          "minLength": 1
        },
        "report_number": {
          "type": "string",
          "minLength": 1
        },
        "report_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "document_path",
        "report_number",
        "report_date",
        "sha256"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "analysis_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "analysis_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "standard_version": {
          "type": "string",
          "minLength": 1
        },
        "fact_ledger": {
          "type": "string",
          "minLength": 1
        },
        "learning_ledger": {
          "type": [
            "string",
            "null"
          ]
        },
        "upstream_artifact_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "analysis_path",
        "analysis_version",
        "standard_version",
        "fact_ledger",
        "learning_ledger",
        "upstream_artifact_id"
      ]
    },
    "questions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "learning_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^L[0-9]{2,}$"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "question",
          "learning_ids"
        ]
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "hypothetical": {
            "const": true
          },
          "brief": {
            "type": "string",
            "minLength": 1
          },
          "learning_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^L[0-9]{2,}$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "facilitator_prompt": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "hypothetical",
          "brief",
          "learning_ids",
          "facilitator_prompt"
        ]
      }
    },
    "actions": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "level": {
            "type": "string",
            "enum": [
              "INDIVIDUAL",
              "TEAM"
            ]
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "type": "string",
            "minLength": 1
          },
          "learning_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^L[0-9]{2,}$"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "level",
          "action",
          "verification",
          "learning_ids"
        ]
      }
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "content_review": {
          "type": "string",
          "enum": [
            "PENDING",
            "PASS",
            "FAIL"
          ]
        },
        "asset_review": {
          "type": "string",
          "enum": [
            "PENDING",
            "PASS",
            "FAIL"
          ]
        },
        "final_qc": {
          "type": "string",
          "enum": [
            "PENDING",
            "PASS",
            "FAIL"
          ]
        },
        "expert_approved": {
          "type": "boolean"
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "review_record": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "content_review",
        "asset_review",
        "final_qc",
        "expert_approved",
        "reviewer",
        "review_record"
      ]
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "artifact_id",
    "artifact_type",
    "title",
    "revision",
    "status",
    "source",
    "provenance",
    "questions",
    "scenarios",
    "actions",
    "approvals"
  ]
}
