{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fact ledger v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "document_path": {
          "type": "string",
          "minLength": 1
        },
        "report_number": {
          "type": "string",
          "minLength": 1
        },
        "report_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "document_path",
        "report_number",
        "report_date",
        "sha256"
      ]
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F[0-9]{2,}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "OBSERVED_FACT",
              "INVESTIGATOR_FINDING",
              "REPORTED_ASSESSMENT",
              "SOURCE_LIMITATION"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "section": {
            "type": "string",
            "minLength": 1
          },
          "printed_pages": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "pdf_pages": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "qualification": {
            "type": [
              "string",
              "null"
            ]
          },
          "review_status": {
            "type": "string",
            "enum": [
              "PENDING",
              "PASS",
              "FAIL"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "statement",
          "section",
          "printed_pages",
          "pdf_pages",
          "qualification",
          "review_status"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "source",
    "facts"
  ]
}
