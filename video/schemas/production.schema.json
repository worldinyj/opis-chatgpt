{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OPIS production manifest v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "artifact_type": {
      "type": "string",
      "enum": [
        "INCIDENT_UNDERSTANDING",
        "SAFETY_CULTURE_LEARNING",
        "KEY_MESSAGE_SHORT"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "PLANNED",
        "SCRIPT_DRAFT",
        "CONTENT_REVIEWED",
        "ASSET_READY",
        "EDITED",
        "FINAL_QC",
        "APPROVED",
        "STALE"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "document_path": {
          "type": "string",
          "minLength": 1
        },
        "report_number": {
          "type": "string",
          "minLength": 1
        },
        "report_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "document_path",
        "report_number",
        "report_date",
        "sha256"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "analysis_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "analysis_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "standard_version": {
          "type": "string",
          "minLength": 1
        },
        "fact_ledger": {
          "type": "string",
          "minLength": 1
        },
        "learning_ledger": {
          "type": [
            "string",
            "null"
          ]
        },
        "upstream_artifact_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "analysis_path",
        "analysis_version",
        "standard_version",
        "fact_ledger",
        "learning_ledger",
        "upstream_artifact_id"
      ]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aspect_ratio": {
          "type": "string",
          "enum": [
            "9:16",
            "16:9"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "language": {
          "const": "ko"
        },
        "style": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "aspect_ratio",
        "width",
        "height",
        "fps",
        "language",
        "style"
      ]
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "target_seconds"
      ]
    },
    "learning_objectives": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "CHARACTER",
              "LOCATION",
              "EQUIPMENT",
              "IMAGE",
              "OTHER"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "review_status": {
            "type": "string",
            "enum": [
              "PENDING",
              "PASS",
              "FAIL"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "description",
          "path",
          "sha256",
          "review_status"
        ]
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "duration_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "overlap_to_next_seconds": {
            "type": "number",
            "minimum": 0
          },
          "scene_type": {
            "type": "string",
            "enum": [
              "FACT",
              "INTERPRETATION",
              "HYPOTHETICAL",
              "REFLECTION",
              "ATTRIBUTE_SUMMARY",
              "TITLE",
              "OUTRO"
            ]
          },
          "fact_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^F[0-9]{2,}$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "learning_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^L[0-9]{2,}$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "principle_codes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "PA",
                "QA",
                "CO",
                "LA",
                "DM",
                "WE",
                "CL",
                "PI",
                "RC",
                "WP"
              ]
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "attribute_codes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "PA1",
                "PA2",
                "PA3",
                "QA1",
                "QA2",
                "QA3",
                "QA4",
                "CO1",
                "CO2",
                "CO3",
                "CO4",
                "LA1",
                "LA2",
                "LA3",
                "LA4",
                "LA5",
                "LA6",
                "LA7",
                "LA8",
                "DM1",
                "DM2",
                "DM3",
                "WE1",
                "WE2",
                "WE3",
                "WE4",
                "CL1",
                "CL2",
                "CL3",
                "CL4",
                "PI1",
                "PI2",
                "PI3",
                "PI4",
                "RC1",
                "RC2",
                "WP1",
                "WP2",
                "WP3",
                "WP4"
              ]
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "render_mode": {
            "type": "string",
            "enum": [
              "I2V",
              "STILL_MOTION",
              "CONTROLLED_GRAPHIC",
              "HYBRID"
            ]
          },
          "generation_route": {
            "type": "string",
            "enum": [
              "INDIVIDUAL",
              "GEMINI_TASKS_BATCH",
              "LOCAL_EDIT"
            ]
          },
          "location_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "reference_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "visual_brief": {
            "type": "string",
            "minLength": 1
          },
          "narration": {
            "type": "string"
          },
          "overlay": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "input_mode": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "single_start",
              "start_end",
              "three_keyframes",
              null
            ]
          },
          "motion_plan": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "start_scale": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "end_scale": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "pan": {
                "type": "string",
                "enum": [
                  "NONE",
                  "LEFT",
                  "RIGHT",
                  "UP",
                  "DOWN"
                ]
              }
            },
            "required": [
              "start_scale",
              "end_scale",
              "pan"
            ]
          },
          "transition": {
            "type": "string",
            "enum": [
              "OPENING",
              "CUT",
              "CONTINUOUS",
              "CONTEXT_SHIFT"
            ]
          },
          "attempts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "take": {
                  "type": "integer",
                  "minimum": 1
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1
                },
                "route": {
                  "type": "string",
                  "enum": [
                    "INDIVIDUAL",
                    "GEMINI_TASKS_BATCH",
                    "LOCAL_EDIT"
                  ]
                },
                "tool": {
                  "type": "string",
                  "minLength": 1
                },
                "settings": {
                  "type": "object"
                },
                "result": {
                  "type": "string",
                  "enum": [
                    "PENDING",
                    "ACCEPTED",
                    "REJECTED",
                    "FAILED"
                  ]
                },
                "path": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "sha256": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[a-f0-9]{64}$"
                },
                "actual_seconds": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "exclusiveMinimum": 0
                },
                "notes": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "take",
                "revision",
                "route",
                "tool",
                "settings",
                "result",
                "path",
                "sha256",
                "actual_seconds",
                "notes"
              ]
            }
          },
          "accepted_take": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "review_status": {
            "type": "string",
            "enum": [
              "PENDING",
              "PASS",
              "FAIL"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "duration_seconds",
          "overlap_to_next_seconds",
          "scene_type",
          "fact_ids",
          "learning_ids",
          "principle_codes",
          "attribute_codes",
          "render_mode",
          "generation_route",
          "location_id",
          "reference_ids",
          "visual_brief",
          "narration",
          "overlay",
          "input_mode",
          "motion_plan",
          "transition",
          "attempts",
          "accepted_take",
          "review_status"
        ]
      }
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "content_review": {
          "type": "string",
          "enum": [
            "PENDING",
            "PASS",
            "FAIL"
          ]
        },
        "asset_review": {
          "type": "string",
          "enum": [
            "PENDING",
            "PASS",
            "FAIL"
          ]
        },
        "final_qc": {
          "type": "string",
          "enum": [
            "PENDING",
            "PASS",
            "FAIL"
          ]
        },
        "expert_approved": {
          "type": "boolean"
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "review_record": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "content_review",
        "asset_review",
        "final_qc",
        "expert_approved",
        "reviewer",
        "review_record"
      ]
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "artifact_id",
    "artifact_type",
    "title",
    "revision",
    "status",
    "source",
    "provenance",
    "profile",
    "timing",
    "learning_objectives",
    "references",
    "scenes",
    "approvals"
  ]
}
